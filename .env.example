　
# Privy Configuration
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Backend Configuration
NEXT_PUBLIC_BACKEND_API_URL=
NEXT_PUBLIC_WHITELIST_POSITION=
NEXT_PUBLIC_DISABLE_COMING_SOON=true
NEXT_PUBLIC_ENABLE_API_V1=true
NEXT_PUBLIC_ENABLE_MARKET_CONTROLS=true

# Solana Configuration for NFT Claiming
SOLANA_BACKEND_PRIVATE_KEY=[1,2,3,...] # Your backend wallet private key as JSON array
SOLANA_RPC_URL=https://api.devnet.solana.com # Optional: Custom RPC URL
NEXT_PUBLIC_SOLANA_NETWORK=devnet # Set to "mainnet" or "devnet"

# Network-specific RPC URLs (optional - defaults to public endpoints if not set)
MAINNET_RPC_URL=https://api.mainnet-beta.solana.com # Custom mainnet RPC
DEVNET_RPC_URL=https://api.devnet.solana.com # Custom devnet RPC

# Helius API Key for DAS (Digital Asset Standard) API
HELIUS_API_KEY=your_helius_api_key_here # Required for cNFT metadata queries

# cNFT Collection Configuration
SOLANA_MERKLE_TREE_ADDRESS=your_merkle_tree_address_here
SOLANA_COLLECTION_MINT=your_collection_mint_address_here # Used for collection metadata and attributes
NFT_METADATA_URI=https://arweave.net/your-metadata.json # Optional: Fallback metadata URI (when Irys upload fails)
NEXT_PUBLIC_COLLECTION_ID=genesis-pioneer-bee-v1 # Unique ID for this collection (change when deploying new collection)

# Note: 
# - The Helius API key is required for querying compressed NFT metadata and ownership.
#   Get your free API key at: https://www.helius.dev/
# - Metadata is automatically uploaded to Arweave using Irys. Ensure your wallet has SOL for gas fees.
# - For mainnet, you may need to fund your Irys/Bundlr account separately.