# Privy Configuration
NEXT_PUBLIC_PRIVY_APP_ID=

# Solana Backend Wallet Private Key
# This wallet will pay for the gas fees for minting NFTs
SOLANA_BACKEND_PRIVATE_KEY=

# Solana Network Configuration
# Set to "mainnet" or "devnet"
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Merkle Tree and Collection Configuration
SOLANA_MERKLE_TREE_ADDRESS=
SOLANA_COLLECTION_MINT=

# Optional: Custom RPC URLs
# If not set, defaults to public RPC endpoints
DEVNET_RPC_URL=
MAINNET_RPC_URL=

# Helius API Key for DAS API
HELIUS_API_KEY=

# Optional: Collection identifier for localStorage
# Change this when deploying a new collection to separate claim records
NEXT_PUBLIC_COLLECTION_ID=genesis-pioneer-bee-v1